# Isolated test environment; no deployment configuration or credentials.
FROM docker.io/library/golang@sha256:ba4c8df3f74321b0d5c44911ccb694c8156340b684eed1fae09a9bd9f7a82b4d
RUN apt-get update && apt-get install -y --no-install-recommends nftables=1.1.3-1 iproute2=6.15.0-1
ENV GOTOOLCHAIN=local
WORKDIR /workspace
